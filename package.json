{
  "name": "universal-mcp-gateway",
  "version": "0.18.0",
  "private": true,
  "description": "Local MCP gateway and its operator dashboard, as a pnpm workspace.",
  "scripts": {
    "dev": "pnpm run dev:gateway",
    "dev:gateway": "pnpm --filter @universal-mcp-gateway/gateway dev",
    "dev:dashboard": "pnpm --filter @universal-mcp-gateway/dashboard dev",
    "build": "pnpm run build:gateway && pnpm run build:dashboard",
    "build:gateway": "pnpm --filter @universal-mcp-gateway/gateway build",
    "build:dashboard": "pnpm --filter @universal-mcp-gateway/dashboard build",
    "test": "pnpm run test:gateway && pnpm run test:dashboard",
    "test:gateway": "pnpm --filter @universal-mcp-gateway/gateway test",
    "test:dashboard": "pnpm --filter @universal-mcp-gateway/dashboard test",
    "typecheck": "pnpm --filter @universal-mcp-gateway/gateway typecheck",
    "typecheck:dashboard": "pnpm --filter @universal-mcp-gateway/dashboard typecheck",
    "verify": "pnpm run typecheck && pnpm run typecheck:dashboard && pnpm run test",
    "operator:create": "pnpm --filter @universal-mcp-gateway/gateway operator:create",
    "backup": "pnpm --filter @universal-mcp-gateway/gateway backup",
    "restore": "pnpm --filter @universal-mcp-gateway/gateway restore",
    "soak": "pnpm --filter @universal-mcp-gateway/gateway soak"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.7.0",
      "onFail": "download"
    }
  }
}
