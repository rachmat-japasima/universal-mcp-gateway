{
  "name": "@universal-mcp-gateway/gateway",
  "version": "0.18.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "vitest run",
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json && pnpm run build:migrations",
    "build:migrations": "node -e \"require('node:fs').cpSync('src/infrastructure/database/migrations','dist/infrastructure/database/migrations',{recursive:true})\"",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "dev:gateway": "tsx watch src/index.ts",
    "dev:dashboard": "pnpm --filter @universal-mcp-gateway/dashboard dev",
    "build:gateway": "pnpm run build",
    "build:dashboard": "pnpm --filter @universal-mcp-gateway/dashboard build",
    "typecheck:dashboard": "pnpm --filter @universal-mcp-gateway/dashboard typecheck",
    "test:dashboard": "pnpm --filter @universal-mcp-gateway/dashboard test",
    "verify": "pnpm run typecheck && pnpm run typecheck:dashboard && pnpm test && pnpm run test:dashboard",
    "operator:create": "tsx src/cli/operator-create.ts",
    "backup": "tsx src/cli/backup-main.ts",
    "restore": "tsx src/cli/restore-main.ts",
    "soak": "tsx tests/soak/soak.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.7.0",
      "onFail": "download"
    }
  },
  "type": "module",
  "dependencies": {
    "@hono/node-server": "^2.1.8",
    "@modelcontextprotocol/client": "^2.4.0",
    "@modelcontextprotocol/hono": "^2.0.2",
    "@modelcontextprotocol/server": "^2.4.0",
    "better-sqlite3": "^13.2.0",
    "hono": "^4.13.19",
    "pino": "^10.4.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
