# Copy to .env and adjust. Nothing here is a real secret.
# Only CREDENTIAL_HASH_SECRET has no default and must be set before /mcp works.
# No dotenv loader is built in: export these, or use your process manager.

HOST=127.0.0.1
PORT=8787
DATABASE_PATH=./data/gateway.db
LOG_LEVEL=info
ENVIRONMENT=development

# >= 32 chars. Read outside Config; production refuses to start without it.
# Generate: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
CREDENTIAL_HASH_SECRET=
CREDENTIAL_HASH_KEY_ID=v1

ALLOW_PRIVATE_NETWORK=false
TOOL_DISCOVERY_TIMEOUT_MS=15000
TOOL_CALL_TIMEOUT_MS=60000

# Phase 10.0 — operator session. Create the operator with `pnpm operator:create`
# (stdin prompt; never an argv password). There is no default password.
OPERATOR_SESSION_IDLE_TIMEOUT_MS=1800000
OPERATOR_SESSION_MAX_LIFETIME_MS=43200000
# Set true only when serving the dashboard over HTTPS. A `Secure` cookie on
# plain-HTTP loopback is silently dropped, so login would appear to do nothing.
OPERATOR_COOKIE_SECURE=false

# Phase 12 — managed integrations (ADR-051). Only needed to store integration
# credentials; without it the gateway runs MCP-only and the vault fails closed
# on first use. 32 bytes, base64: generate like CREDENTIAL_HASH_SECRET above.
# PREVIOUS keeps old envelopes readable during rotation; remove it after.
INTEGRATION_MASTER_KEY=
# INTEGRATION_MASTER_KEY_PREVIOUS=
