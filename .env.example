# Copy to .env and adjust. Nothing here is a real secret.
# Only CREDENTIAL_HASH_SECRET has no default and must be set before /mcp works.
# No dotenv loader is built in: export these, or use your process manager.

HOST=127.0.0.1
PORT=8787
DATABASE_PATH=./data/gateway.db
LOG_LEVEL=info
ENVIRONMENT=development

# >= 32 chars. Read outside Config; production refuses to start without it.
# Generate: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
CREDENTIAL_HASH_SECRET=
CREDENTIAL_HASH_KEY_ID=v1

ALLOW_PRIVATE_NETWORK=false
TOOL_DISCOVERY_TIMEOUT_MS=15000
TOOL_CALL_TIMEOUT_MS=60000
